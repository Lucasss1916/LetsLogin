# 随机 64 位十六进制(openssl rand -hex 32)
JWT_SECRET=change-me-jwt-secret
# 32字节密钥的 hex(openssl rand -hex 32),用于 AES-256-GCM 加密账号密码与 2FA secret
SECRETS_KEY=change-me-64-hex-chars
# 首次启动创建的管理员密码(用户名 admin,首次登录强制改密)
ADMIN_INITIAL_PASSWORD=admin123
# 可选:apexstatus(mozambiquehe)免费 API key,用于 Apex 地图轮换页的官方实时数据
# 注册:https://apexlegendsstatus.com -> API;未配置时按标准轮换周期本地推算(赛季更替需手动更新地图池)
APEX_API_KEY=

# 可选:Apex 赛季倒计时精确校准(NAME + ENDS_AT 两项都填才生效,否则按社区口径推算并在页面标注"推算")
# 下面是 2026-10-23 核对的真实值,可直接取消注释使用;换赛季/换段时整组更新
# 末段(本例 Split 2)的段末即赛季末,SPLIT_ENDS_AT 与 ENDS_AT 填同一时刻,页面会自动只显示一个倒计时
# SOURCE 会原样显示在赛季卡上,写清出处与核对日期,过期时才知道该找谁对
# APEX_SEASON_NAME=Season 30 · Marked
# APEX_SEASON_SPLIT=2
# APEX_SEASON_STARTS_AT=2026-08-04T18:00:00Z
# APEX_SEASON_SPLIT_ENDS_AT=2026-11-03T18:00:00Z
# APEX_SEASON_ENDS_AT=2026-11-03T18:00:00Z
# APEX_SEASON_SOURCE=EA 官方赛季/中赛季公告(Split 2 自 09-15 起),经 apexseasons.online 汇总校对 · 2026-10-23 核对 · 结束时刻为预计

# 可选:SMTP 发信(用于邀请码直达邮箱)。推荐自建 Stalwart/Mailcow 或中继,见 docs 相关说明
# SMTP_HOST=mail.example.com
# SMTP_PORT=465
# SMTP_USER=invite@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=Let's Log !n <invite@example.com>

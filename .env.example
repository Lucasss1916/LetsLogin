# 随机 64 位十六进制(openssl rand -hex 32)
JWT_SECRET=change-me-jwt-secret
# 32字节密钥的 hex(openssl rand -hex 32),用于 AES-256-GCM 加密账号密码与 2FA secret
SECRETS_KEY=change-me-64-hex-chars
# 首次启动创建的管理员密码(用户名 admin,首次登录强制改密)
ADMIN_INITIAL_PASSWORD=admin123
# 可选:apexstatus(mozambiquehe)免费 API key,用于 Apex 地图轮换页的官方实时数据
# 注册:https://apexlegendsstatus.com -> API;未配置时按标准轮换周期本地推算(赛季更替需手动更新地图池)
APEX_API_KEY=

{
  "applicationId": "com.yg.apexcfg",
  "version": "1.2.0",
  "defaultMode": "window",
  "port": 0,
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": { "enabled": true, "writeToLogFile": false },
  "nativeAllowList": [
    "app.*", "os.*", "filesystem.*", "window.*", "storage.*", "debug.*", "events.*"
  ],
  "modes": {
    "window": {
      "title": "Apex 配置工具",
      "width": 1280, "height": 850,
      "minWidth": 1024, "minHeight": 680,
      "fullScreen": false, "alwaysOnTop": false,
      "enableInspector": false,
      "borderless": true,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "ApexConfigTool",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.3.0"
  }
}
